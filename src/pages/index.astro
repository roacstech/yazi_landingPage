---
import Layout from '../layouts/Layout.astro';

// Import all your 11 JSX sections
import Hero from '../components/hero/Hero.jsx';
import TrustStats from '../components/trust-stats/TrustStats.jsx';
import AgentProblem from '../components/agent-problem/AgentProblem.jsx';
import PlatformSolution from '../components/platform-solution/PlatformSolution.jsx';
import CoreFeatures from '../components/core-features/CoreFeatures.jsx';
import ProductScreenshots from '../components/product-screenshots/ProductScreenshots.jsx';
import WhyChooseUs from '../components/why-choose-us/WhyChooseUs.jsx';
import AgentTestimonial from '../components/agent-testimonial/AgentTestimonial.jsx';
import FAQ from '../components/faq/FAQ.jsx';
import FinalCTA from '../components/final-cta/FinalCTA.jsx';
import Footer from '../components/footer/Footer.jsx';

import { getActiveYaziAirlines } from '../utils/airlines';

// Fetch airlines cleanly via utility function (Server-side for fast load, SEO, and zero CORS issues)
const airlines = await getActiveYaziAirlines();
---

<Layout>
  <main class="min-h-screen bg-white text-neutral-900 selection:bg-cyan-500 selection:text-white">
    <!--<Hero client:load />-->
    <TrustStats client:visible airlines={airlines} />
    <!--<AgentProblem />-->
  </main>
</Layout>